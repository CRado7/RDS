# -----------------------------
# Base ignores for development
# -----------------------------

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/

# Environment files
.env
.env.*

# Build cache
.cache
.parcel-cache
.temp
.docusaurus
.svelte-kit
.serverless

# Test and coverage
coverage/
*.lcov

# IDE / editor
.vscode/
.idea/
*.swp

# Output of tools
*.tsbuildinfo
*.tgz

# Misc build systems
bower_components/
dist.zip

# -----------------------------
# Framework-specific ignores
# -----------------------------
.next
out
.nuxt
public
build/
web_modules/

# -----------------------------
# Deployment setup
# -----------------------------

# Only include dist in the deploy branch
# When deploying with "git subtree push --prefix dist origin deploy",
# this ensures only dist/ is tracked there.
# (No need to ignore dist for your main branch build process.)
