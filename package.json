{
  "name": "radodesignstudio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp _redirects dist/_redirects && cp .cpanel.yml dist/.cpanel.yml && node ./scripts/generate-sitemap.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "git checkout deploy && git merge main && npm run build && cp -R dist/. ~/public_html/ && git add . && git commit -m 'Auto deploy' && git push origin deploy && git checkout main"
  },
  "dependencies": {
    "@react-spring/three": "^10.0.2",
    "@react-three/drei": "^9.x",
    "@react-three/fiber": "^8.x",
    "@react-three/postprocessing": "^2.16.0",
    "framer-motion": "^12.23.22",
    "pixi.js": "^8.19.0",
    "postprocessing": "^6.37.7",
    "react": "^18.3.1",
    "react-compare-image": "^3.5.9",
    "react-compare-slider": "^3.1.0",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.8.2",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "sitemap": "^8.0.0",
    "vite": "^7.1.2",
    "vite-plugin-svgr": "^4.5.0"
  },
